{
  "name": "@syntyr/css",
  "version": "0.3.0-alpha.5",
  "description": "Framework-neutral CSS-first design system for modern apps and sites; no runtime JavaScript",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dporkka/syntyr-css.git"
  },
  "homepage": "https://syntyr-css.pages.dev/",
  "style": "./dist/syntyr.core.css",
  "exports": {
    ".": "./dist/syntyr.core.css",
    "./core.css": "./dist/syntyr.core.css",
    "./semantic.css": "./dist/syntyr.semantic.css",
    "./server.css": "./dist/syntyr.server.css",
    "./semantic-bundle.css": "./dist/syntyr.semantic-bundle.css",
    "./recipes.css": "./dist/syntyr.recipes.css",
    "./operations.css": "./dist/syntyr.operations.css",
    "./data-grid.css": "./dist/syntyr.data-grid.css",
    "./effects.css": "./dist/syntyr.effects.css",
    "./motion.css": "./dist/syntyr.motion.css",
    "./geometry.css": "./dist/syntyr.geometry.css",
    "./symbols.css": "./dist/syntyr.symbols.css",
    "./utilities.css": "./dist/syntyr.utilities.css",
    "./print.css": "./dist/syntyr.print.css",
    "./syntyr.css": "./dist/syntyr.css",
    "./all.css": "./dist/syntyr.all.css",
    "./viz.css": "./dist/syntyr.viz.css",
    "./components/tokens.css": "./dist/components/tokens.css",
    "./components/base.css": "./dist/components/base.css",
    "./components/layout.css": "./dist/components/layout.css",
    "./components/typography.css": "./dist/components/typography.css",
    "./components/buttons.css": "./dist/components/buttons.css",
    "./components/forms.css": "./dist/components/forms.css",
    "./components/form-composition.css": "./dist/components/form-composition.css",
    "./components/overlays.css": "./dist/components/overlays.css",
    "./components/data.css": "./dist/components/data.css",
    "./components/patterns.css": "./dist/components/patterns.css",
    "./native-recipes.css": "./dist/syntyr.native-recipes.css",
    "./tailwind.css": "./integrations/tailwind/syntyr.theme.css",
    "./shadcn.css": "./integrations/shadcn/syntyr.tokens.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist/",
    "integrations/tailwind/",
    "integrations/shadcn/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "css",
    "design-system",
    "css-framework",
    "no-javascript",
    "css-only",
    "themes"
  ]
}
