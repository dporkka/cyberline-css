{
  "schema_version": 1,
  "source_version": "0.3.0-alpha.5",
  "completeness": "curated-subset",
  "note": "Validated examples, not a complete inventory. Check the installed release; candidate-only classes may not exist in alpha.4.",
  "components": [
    {
      "name": "Button",
      "module": "syntyr.core.css",
      "elements": [
        "button",
        "a"
      ],
      "classes": [
        "syn-button",
        "syn-button--primary",
        "syn-button--outline",
        "syn-button--danger",
        "syn-button--ghost"
      ],
      "notes": "Use button for actions and a for navigation. ARIA states describe real application state."
    },
    {
      "name": "Panel",
      "module": "syntyr.core.css",
      "elements": [
        "article",
        "section",
        "div"
      ],
      "classes": [
        "syn-panel",
        "syn-panel--cut"
      ],
      "notes": "Choose native headings and accessible labels."
    },
    {
      "name": "Form fields",
      "module": "syntyr.core.css",
      "elements": [
        "form",
        "label",
        "input",
        "p"
      ],
      "classes": [
        "syn-form",
        "syn-label",
        "syn-input",
        "syn-error"
      ],
      "notes": "Real handlers and field validation belong to the application."
    },
    {
      "name": "Form compositions",
      "module": "syntyr.core.css",
      "elements": [
        "form",
        "label",
        "input",
        "button",
        "span",
        "div"
      ],
      "classes": [
        "syn-field",
        "syn-field-row",
        "syn-field-body",
        "syn-input-group",
        "syn-input-addon"
      ],
      "notes": "Unreleased alpha.5 candidate only. Native form behavior, associated labels, server validation; use syn-region for container-responsive rows. The Radix adapter is separately optional."
    },
    {
      "name": "Tables",
      "module": "syntyr.core.css",
      "elements": [
        "div",
        "table"
      ],
      "classes": [
        "syn-table-wrap",
        "syn-table",
        "syn-cell--numeric"
      ],
      "notes": "Use proper headers, captions and scroll containers."
    },
    {
      "name": "Stats",
      "module": "syntyr.core.css",
      "elements": [
        "section",
        "article",
        "p"
      ],
      "classes": [
        "syn-region",
        "syn-stats",
        "syn-stat",
        "syn-stat-label",
        "syn-stat-value"
      ],
      "notes": "Named container must be an ancestor of responsive children."
    },
    {
      "name": "Navigation",
      "module": "syntyr.core.css",
      "elements": [
        "nav",
        "ol",
        "li",
        "a"
      ],
      "classes": [
        "syn-breadcrumbs",
        "syn-pagination",
        "syn-page-link"
      ],
      "notes": "Real links and aria-current only for the actual current page."
    },
    {
      "name": "Application shell",
      "module": "syntyr.recipes.css",
      "elements": [
        "div",
        "aside",
        "main"
      ],
      "classes": [
        "syn-app-shell",
        "syn-app-rail",
        "syn-app-nav",
        "syn-workspace"
      ],
      "notes": "Load optional recipes CSS after core."
    },
    {
      "name": "Marketing hero",
      "module": "syntyr.recipes.css",
      "elements": [
        "section",
        "h1"
      ],
      "classes": [
        "syn-site-hero",
        "syn-site-heading"
      ],
      "notes": "Load optional recipes CSS after core."
    },
    {
      "name": "Charts",
      "module": "syntyr.viz.css",
      "elements": [
        "figure",
        "figcaption"
      ],
      "classes": [
        "syn-chart",
        "syn-chart-title"
      ],
      "notes": "Only styling hooks. Generate chart values and SVG geometry yourself."
    },
    {
      "name": "Heatmap",
      "module": "syntyr.viz.css",
      "elements": [
        "div",
        "span"
      ],
      "classes": [
        "syn-viz-heatmap",
        "syn-viz-cell"
      ],
      "notes": "Supply textual cell labels, data-syn-level and real data."
    },
    {
      "name": "Advanced geometry frames",
      "module": "syntyr.geometry.css",
      "elements": [
        "article",
        "section",
        "div"
      ],
      "classes": [
        "syn-frame",
        "syn-frame--bevel",
        "syn-frame--notch",
        "syn-frame--bracket",
        "syn-frame--accent"
      ],
      "notes": "Load optional geometry CSS. One shape per frame; accent emphasis is additive. Refer to visual-intensity.md for pseudo-element ownership and backgrounds."
    },
    {
      "name": "Decorative effects",
      "module": "syntyr.effects.css",
      "elements": [
        "article",
        "section",
        "div"
      ],
      "classes": [
        "syn-glow",
        "syn-grid-effect",
        "syn-gradient-wash"
      ],
      "notes": "Optional CSS only. data-syn-intensity on .syn-root or nested regions selects quiet, standard or cinematic effects without changing semantic state."
    },
    {
      "name": "CRM compositions",
      "module": "syntyr.recipes.css",
      "elements": [
        "form",
        "label",
        "div",
        "section",
        "ul",
        "li",
        "dl"
      ],
      "classes": [
        "syn-filter-bar",
        "syn-filter-field",
        "syn-filter-field--query",
        "syn-filter-actions",
        "syn-pipeline",
        "syn-pipeline-lane",
        "syn-pipeline-list",
        "syn-pipeline-card",
        "syn-record-fields"
      ],
      "notes": "Unreleased alpha.5, CSS-only optional layouts. Use a GET form, labelled stages, focusable board overflow and definition-list details; application implements filtering and pipeline state."
    }
  ],
  "recipes": [
    {
      "id": "crm-filter",
      "description": "Server-driven filter toolbar with wrapping fields and submit/reset actions.",
      "stylesheets": [
        "syntyr.core.css",
        "syntyr.recipes.css"
      ],
      "root": {
        "tag": "form",
        "classes": [
          "syn-filter-bar"
        ]
      },
      "slots": [
        {
          "name": "field",
          "tag": "label",
          "classes": [
            "syn-filter-field"
          ],
          "optional": false,
          "repeatable": true
        },
        {
          "name": "query",
          "tag": "label",
          "classes": [
            "syn-filter-field",
            "syn-filter-field--query"
          ],
          "optional": true,
          "repeatable": false
        },
        {
          "name": "actions",
          "tag": "div",
          "classes": [
            "syn-filter-actions"
          ],
          "optional": false,
          "repeatable": false
        }
      ],
      "variants": {
        "data-syn-density": [
          "comfortable",
          "compact"
        ]
      },
      "host_behavior": "Supply method=get, named controls, actual action URL and meaningful reset link. The host filters results; CSS does not execute queries.",
      "example": "examples/saas-workflows.html"
    },
    {
      "id": "resource-table",
      "description": "Horizontally scrollable semantic data table with optional numeric cells and native pagination links.",
      "stylesheets": [
        "syntyr.core.css"
      ],
      "root": {
        "tag": "div",
        "classes": [
          "syn-table-wrap"
        ]
      },
      "slots": [
        {
          "name": "table",
          "tag": "table",
          "classes": [
            "syn-table"
          ],
          "optional": false,
          "repeatable": false
        },
        {
          "name": "numeric-cell",
          "tag": "td",
          "classes": [
            "syn-cell--numeric"
          ],
          "optional": true,
          "repeatable": true
        },
        {
          "name": "pagination",
          "tag": "nav",
          "classes": [
            "syn-pagination"
          ],
          "optional": true,
          "repeatable": false
        }
      ],
      "variants": {
        "data-syn-density": [
          "comfortable",
          "compact"
        ]
      },
      "host_behavior": "Provide caption, real th scope associations, keyboard-reachable horizontal overflow where needed, actual page links and server-side sort/filter. CSS does not sort, page or select records.",
      "example": "examples/saas-workflows.html"
    },
    {
      "id": "app-shell",
      "description": "Responsive application shell with navigation rail and primary workspace.",
      "stylesheets": [
        "syntyr.core.css",
        "syntyr.recipes.css"
      ],
      "root": {
        "tag": "div",
        "classes": [
          "syn-app-shell"
        ]
      },
      "slots": [
        {
          "name": "rail",
          "tag": "aside",
          "classes": [
            "syn-app-rail"
          ],
          "optional": false,
          "repeatable": false
        },
        {
          "name": "navigation",
          "tag": "nav",
          "classes": [
            "syn-app-nav"
          ],
          "optional": false,
          "repeatable": false
        },
        {
          "name": "workspace",
          "tag": "main",
          "classes": [
            "syn-workspace"
          ],
          "optional": false,
          "repeatable": false
        }
      ],
      "variants": {
        "data-syn-theme": [
          "studio",
          "grid",
          "noir"
        ]
      },
      "host_behavior": "Provide labelled navigation, unique main landmark, actual routes and authorization for each destination. Theme must be placed on .syn-root or a scoped ancestor.",
      "example": "examples/operations-console.html"
    },
    {
      "id": "validated-form",
      "description": "Labeled field/error compositions for host-validated forms.",
      "stylesheets": [
        "syntyr.core.css"
      ],
      "root": {
        "tag": "form",
        "classes": [
          "syn-form"
        ]
      },
      "slots": [
        {
          "name": "field",
          "tag": "div",
          "classes": [
            "syn-field"
          ],
          "optional": false,
          "repeatable": true
        },
        {
          "name": "label",
          "tag": "label",
          "classes": [
            "syn-label"
          ],
          "optional": false,
          "repeatable": true
        },
        {
          "name": "input",
          "tag": "input",
          "classes": [
            "syn-input"
          ],
          "optional": false,
          "repeatable": true
        },
        {
          "name": "error",
          "tag": "p",
          "classes": [
            "syn-error"
          ],
          "optional": true,
          "repeatable": true
        }
      ],
      "variants": {
        "data-syn-density": [
          "comfortable",
          "compact"
        ]
      },
      "host_behavior": "Host supplies server/client validation, error text, stable error IDs, aria-describedby, aria-invalid and focus to an error summary when submission fails. CSS never performs validation or focus changes.",
      "example": "examples/form-composition.html"
    },
    {
      "id": "enterprise-table",
      "description": "Opt-in scroll-bounded native data table with sticky headings, striping and truthfully annotated sort state.",
      "stylesheets": [
        "syntyr.core.css"
      ],
      "root": {
        "tag": "div",
        "classes": [
          "syn-table-wrap",
          "syn-table-wrap--scroll"
        ]
      },
      "slots": [
        {
          "name": "table",
          "tag": "table",
          "classes": [
            "syn-table",
            "syn-table--sticky",
            "syn-table--striped"
          ],
          "optional": false,
          "repeatable": false
        },
        {
          "name": "sort-indicator",
          "tag": "span",
          "classes": [
            "syn-table-sort"
          ],
          "optional": true,
          "repeatable": true
        },
        {
          "name": "numeric-cell",
          "tag": "td",
          "classes": [
            "syn-cell--numeric"
          ],
          "optional": true,
          "repeatable": true
        }
      ],
      "variants": {
        "data-syn-density": [
          "compact",
          "comfortable",
          "spacious"
        ]
      },
      "host_behavior": "Set role=region with a visible focus ring, meaningful aria-label and tabindex=0 when a table actually overflows. Provide caption and scoped header cells. Apply aria-sort only to the column truly sorted by application data. The server must perform sorting, filtering and paging; CSS only renders indicators. Verify real RTL navigation and print long tables without clipping.",
      "example": "examples/data-tables.html"
    },
    {
      "id": "collection-workspace",
      "description": "Responsive resource workspace with filtering, native data table, bulk-selection presentation, empty states and linked error recovery.",
      "stylesheets": [
        "syntyr.core.css",
        "syntyr.recipes.css"
      ],
      "root": {
        "tag": "section",
        "classes": [
          "syn-app-card"
        ]
      },
      "slots": [
        {
          "name": "toolbar",
          "tag": "div",
          "classes": [
            "syn-collection-toolbar"
          ],
          "optional": false,
          "repeatable": false
        },
        {
          "name": "filter",
          "tag": "form",
          "classes": [
            "syn-filter-bar"
          ],
          "optional": false,
          "repeatable": false
        },
        {
          "name": "actions",
          "tag": "div",
          "classes": [
            "syn-collection-actions"
          ],
          "optional": true,
          "repeatable": false
        },
        {
          "name": "table",
          "tag": "table",
          "classes": [
            "syn-table",
            "syn-table--compact"
          ],
          "optional": true,
          "repeatable": false
        },
        {
          "name": "bulk-actions",
          "tag": "div",
          "classes": [
            "syn-bulk-actions"
          ],
          "optional": true,
          "repeatable": false
        },
        {
          "name": "empty-state",
          "tag": "div",
          "classes": [
            "syn-result-state"
          ],
          "optional": true,
          "repeatable": false
        },
        {
          "name": "error-summary",
          "tag": "div",
          "classes": [
            "syn-error-summary"
          ],
          "optional": true,
          "repeatable": false
        }
      ],
      "variants": {
        "data-syn-density": [
          "compact",
          "comfortable",
          "spacious"
        ]
      },
      "host_behavior": "Host owns GET query parsing, server-rendered results and true selected-item counts; never imply disabled demo controls work. Render empty state only when a real query returns no results. Connect error-summary links to unique invalid-field IDs, and move focus to the summary after a failed real submission; CSS does not validate, focus, authorize, delete or mutate resources.",
      "example": "examples/resource-workspace.html"
    }
  ]
}
